    "@taxi/shared": "workspace:*",
    "amqplib": "^0.10.5",
    "ioredis": "^5.4.2",
    "mongodb": "^7.8.0",
    "mysql2": "^3.24.6",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
