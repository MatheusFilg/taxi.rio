{
  "name": "@taxi/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src --concurrency 1"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.7",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.1.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@taxi/shared": "workspace:*",
    "amqplib": "^2.2.1",
    "fastify": "^5.2.0",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.6",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
